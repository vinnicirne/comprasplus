{
  "name": "listadecomprasplus",
  "version": "1.2.0",
  "description": "Compras Plus & Orçamento Inteligente (PWA e Android)",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "build": "node scripts/generate-env.js && vite build && node scripts/prepare-www.js",
    "dev:legacy": "npx serve -l 3000 legacy",
    "dev": "vite",
    "build:vite": "vite build",
    "cap:sync": "node scripts/generate-env.js && node scripts/prepare-www.js && npx cap sync",
    "cap:open": "npx cap open android"
  },
  "keywords": [
    "pwa",
    "android",
    "shopping-list",
    "orcamento",
    "compras"
  ],
  "author": "vinnicirne",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "autoprefixer": "^10.6.0",
    "page": "^1.11.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0"
  }
}
