{
  "name": "listadecomprasplus",
  "version": "1.0.0",
  "description": "Lista de Compras Plus & Orçamento Inteligente (PWA e Android)",
  "main": "index.html",
  "scripts": {
    "build": "node scripts/generate-env.js && node scripts/prepare-www.js",
    "start": "npx serve -l 3000 .",
    "cap:sync": "node scripts/generate-env.js && node scripts/prepare-www.js && npx cap sync",
    "cap:open": "npx cap open android"
  },
  "keywords": [
    "pwa",
    "android",
    "shopping-list",
    "orcamento",
    "compras"
  ],
  "author": "vinnicirne",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/admob": "^7.0.3",
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1"
  }
}
